# Copy to .env; never commit real credentials.
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=blood_donation_app
# Required: enter the password of your existing local MySQL user.
DB_PASSWORD=
DB_NAME=blood_donation_coordination

# Reserved for future authentication; not used in Phase 1.
# Generate your own high-entropy value before implementing sessions.
SESSION_SECRET=
