# Copy to .env; never commit real credentials.
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=blood_donation_app
# Required: enter the password of your existing local MySQL user.
DB_PASSWORD=
DB_NAME=blood_donation_coordination

# Authentication configuration. Use a private random secret of at least
# 32 UTF-8 bytes; never commit the real value. Session expiry defaults to 120
# minutes and accepts 5–1440 minutes.
SESSION_SECRET=
SESSION_TTL_MINUTES=120
